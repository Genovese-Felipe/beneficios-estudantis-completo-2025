{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "category": "02-technical-capabilities",
  "generated_by": "GitHub Copilot (AI assistant)",
  "generation_date": "2025-10-09",
  "note": "Copilot is powered by AI; mistakes are possible. Review carefully.",
  
  "purpose": {
    "description": "Instructions for AI agents working on skills-based technical capability content",
    "focus": "Organize by capability/skill domain, not by vendor or platform"
  },
  
  "key_principles": {
    "organization": [
      "Group by technical capability (e.g., 'Cloud Computing' not 'AWS vs Azure')",
      "Provide cross-platform comparisons within each capability",
      "Focus on skills students can develop, not just tools",
      "Create clear learning progressions (beginner → intermediate → advanced)",
      "Link capabilities to career outcomes"
    ],
    
    "neutrality": [
      "Present multiple platform options fairly",
      "Base recommendations on student needs, not vendor preferences",
      "Acknowledge trade-offs between options",
      "Update when platform landscape changes"
    ],
    
    "practicality": [
      "Emphasize free/student resources",
      "Provide hands-on project ideas",
      "Include real-world use cases",
      "Connect to job market demand"
    ]
  },
  
  "content_structure": {
    "capability_file_template": {
      "required_sections": [
        "Overview: What is this capability?",
        "Core Skills: What you'll learn",
        "Career Paths: Where this leads",
        "Free Resources: Student-accessible platforms",
        "Learning Path: Beginner to Advanced",
        "Project Ideas: Hands-on practice",
        "Certifications: Industry recognition",
        "Estimated Value: Economic impact"
      ]
    },
    
    "platform_comparison_format": {
      "structure": "Table or structured comparison",
      "criteria": [
        "Free tier/credits for students",
        "Learning curve",
        "Industry adoption",
        "Community support",
        "Certification value",
        "Best for (use case)"
      ]
    },
    
    "learning_path_format": {
      "stages": ["Beginner", "Intermediate", "Advanced"],
      "each_stage_includes": [
        "Skills to master",
        "Recommended resources",
        "Time estimate",
        "Success criteria",
        "Project milestone"
      ]
    }
  },
  
  "capabilities_covered": {
    "primary": [
      "cloud-computing",
      "data-science-ml",
      "web-development",
      "devops-sre",
      "cybersecurity",
      "mobile-development",
      "game-development",
      "ai-llm-development"
    ],
    
